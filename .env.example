# --- Backend ---
DATABASE_URL=postgres://nimbus:nimbus@localhost:5432/nimbus
NIMBUS_BIND=0.0.0.0:8080
# Торренты, кэш, сессия librqbit
NIMBUS_DATA_DIR=./data
# ВАЖНО: укажите свой контакт (почта или URL проекта). MusicBrainz ограничивает общий User-Agent-заглушку:
# ответы 503 «throttled», медленный импорт дискографии.
NIMBUS_MB_USER_AGENT="Nimbus/0.3 ( https://github.com/axelrodvl/nimbus )"
# Только для разработки (Vite на другом порту); в Docker интерфейс и API на одном origin.
NIMBUS_CORS_ORIGIN=http://localhost:5173
# Каталог собранного SPA (в образе /app/web, уже задан). НЕ раскомментируйте в Docker: пустое значение отключает интерфейс.
# Для запуска без Docker: NIMBUS_WEB_DIR=client/dist
# NIMBUS_WEB_DIR=

# Torznab (пусто — провайдер выключен)
NIMBUS_TORZNAB_URL=
NIMBUS_TORZNAB_API_KEY=

# RuTracker (пусто — провайдер выключен)
NIMBUS_RUTRACKER_USERNAME=
NIMBUS_RUTRACKER_PASSWORD=
NIMBUS_RUTRACKER_COOKIE=
NIMBUS_RUTRACKER_PROXY=
# FlareSolverr проходит Cloudflare-челлендж RuTracker (HTTP 403 «Cloudflare challenge»).
# Включить контейнер: COMPOSE_PROFILES=flaresolverr (или jackett — Jackett + FlareSolverr), затем
# NIMBUS_FLARESOLVERR_URL=http://flaresolverr:8191
NIMBUS_FLARESOLVERR_URL=
# COMPOSE_PROFILES=flaresolverr

NIMBUS_TPB_ENABLED=true
NIMBUS_CACHE_LIMIT_GB=50
NIMBUS_SEEDING=false
# Лимит раздачи (отдано/скачано); 0 или none — без лимита
NIMBUS_SEED_RATIO=1.0
# Порт входящих BitTorrent-соединений (TCP+UDP). docker compose пробрасывает этот же порт.
# Занят — движок выберет случайный порт. 0 — всегда случайный.
NIMBUS_TORRENT_PORT=6881
# Пусто — авторизация выключена (шаг 23)
NIMBUS_API_TOKEN=
# true — включить /api/debug/* в release-сборке
NIMBUS_DEBUG=false
# Путь к ffmpeg (в Docker-образе он есть)
NIMBUS_FFMPEG=ffmpeg
# json — структурные логи
NIMBUS_LOG_FORMAT=text

# --- docker compose ---
# Порт интерфейса на хосте (http://localhost:8000)
NIMBUS_PORT=8000
POSTGRES_PORT=5432

# --- Релизные образы (deploy/docker-compose.release.yml) ---
# Версия образов из GHCR; в пакете релиза подставляется автоматически.
NIMBUS_VERSION=latest

{
  "openapi": "3.1.0",
  "info": {
    "title": "Nimbus API",
    "description": "Бэкенд веб-плеера Nimbus: метаданные MusicBrainz, музыка из торрентов.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/albums/{id}": {
      "get": {
        "tags": [
          "library"
        ],
        "operationId": "get_album",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlbumDetailDto"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/artists/{id}": {
      "get": {
        "tags": [
          "library"
        ],
        "operationId": "get_artist",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArtistDetailDto"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/debug/albums/{id}/torrents": {
      "get": {
        "tags": [
          "system"
        ],
        "operationId": "debug_album_torrents",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID альбома",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Раздачи альбома: статус метаданных, число файлов и найденных треков (только debug / NIMBUS_DEBUG=true)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/debug/jobs": {
      "get": {
        "tags": [
          "system"
        ],
        "operationId": "debug_jobs",
        "parameters": [
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Список задач (только debug / NIMBUS_DEBUG=true)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/debug/torrent/metadata": {
      "post": {
        "tags": [
          "system"
        ],
        "operationId": "debug_torrent_metadata",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DebugMetadataRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Список файлов торрента без скачивания (только debug / NIMBUS_DEBUG=true)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Некорректный magnet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "Метаданные не получены вовремя",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": [
          "system"
        ],
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Сервис работает, БД доступна",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/library": {
      "post": {
        "tags": [
          "library"
        ],
        "operationId": "add_to_library",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddToLibraryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Уже в библиотеке",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddToLibraryResponse"
                }
              }
            }
          },
          "201": {
            "description": "Альбом или трек добавлен",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddToLibraryResponse"
                }
              }
            }
          },
          "202": {
            "description": "Артист добавлен, дискография импортируется в фоне",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddToLibraryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Некорректный запрос",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "MBID не найден в MusicBrainz (mb_not_found)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Запись не входит в треклист альбома (recording_not_in_release)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "MusicBrainz недоступен (mb_unavailable)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/library/albums": {
      "get": {
        "tags": [
          "library"
        ],
        "operationId": "list_albums",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "description": "Курсор из `next_cursor` предыдущей страницы.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "1..200, по умолчанию 50 (для треков — 100).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlbumPage"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/library/artists": {
      "get": {
        "tags": [
          "library"
        ],
        "operationId": "list_artists",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "description": "Курсор из `next_cursor` предыдущей страницы.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "1..200, по умолчанию 50 (для треков — 100).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArtistPage"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/library/tracks": {
      "get": {
        "tags": [
          "library"
        ],
        "operationId": "list_tracks",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "description": "Фильтр по статусам через запятую: adding, found, not_found, ready (например `found,ready`).",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackPage"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/library/{type}/{id}": {
      "delete": {
        "tags": [
          "library"
        ],
        "operationId": "remove_from_library",
        "parameters": [
          {
            "name": "type",
            "in": "path",
            "description": "artist, album или track",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "description": "id в нашей БД",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Убрано из библиотеки (метаданные сохранены)"
          },
          "400": {
            "description": "Неверный type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Не найдено",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/search": {
      "get": {
        "tags": [
          "search"
        ],
        "operationId": "search",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Строка поиска, 1..200 символов.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "types",
            "in": "query",
            "description": "Через запятую: `artist,album,track` (по умолчанию все).",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "1..25, по умолчанию 8.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Результаты поиска",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "400": {
            "description": "Некорректный запрос (bad_query, bad_types, bad_limit)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/tracks/{id}": {
      "get": {
        "tags": [
          "library"
        ],
        "operationId": "get_track",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackDto"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/tracks/{id}/stream": {
      "get": {
        "tags": [
          "library"
        ],
        "operationId": "stream_track",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID трека",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Аудио целиком (`audio/*`)"
          },
          "206": {
            "description": "Часть аудио по заголовку Range"
          },
          "404": {
            "description": "Нет такого трека",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Трек не `found`/`ready` (`track_not_playable`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "Формат требует перекодирования (`transcode_required`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "416": {
            "description": "Диапазон вне файла",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "501": {
            "description": "CUE-образ (`cue_not_supported`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "Нет пиров: данные не пришли вовремя (`no_peers`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/ws": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Только документация: сам обработчик — `ws::ws_handler`.",
        "operationId": "ws_doc",
        "responses": {
          "101": {
            "description": "WebSocket: события `track.status`, `job.progress`, `stream.progress`, `library.changed`, `resync`"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddStatus": {
        "type": "string",
        "enum": [
          "added",
          "importing",
          "exists"
        ]
      },
      "AddToLibraryRequest": {
        "type": "object",
        "required": [
          "type",
          "mbid"
        ],
        "properties": {
          "album_mbid": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Для `track`: MBID release group альбома (иначе определяется по MusicBrainz)."
          },
          "mbid": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "$ref": "#/components/schemas/LibraryKind",
            "description": "`artist`, `album` (MBID release group) или `track` (MBID recording)."
          }
        }
      },
      "AddToLibraryResponse": {
        "type": "object",
        "required": [
          "type",
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "$ref": "#/components/schemas/AddStatus"
          },
          "type": {
            "$ref": "#/components/schemas/LibraryKind"
          }
        }
      },
      "AlbumDetailDto": {
        "type": "object",
        "required": [
          "album",
          "artist",
          "tracks"
        ],
        "properties": {
          "album": {
            "$ref": "#/components/schemas/AlbumDto"
          },
          "artist": {
            "$ref": "#/components/schemas/ArtistDto"
          },
          "tracks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrackDto"
            },
            "description": "Все треки альбома с флагом `in_library`."
          }
        }
      },
      "AlbumDto": {
        "type": "object",
        "required": [
          "id",
          "mbid",
          "title",
          "artist_id",
          "artist_name",
          "in_library",
          "track_count",
          "status_counts"
        ],
        "properties": {
          "artist_id": {
            "type": "integer",
            "format": "int64"
          },
          "artist_name": {
            "type": "string"
          },
          "cover_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "in_library": {
            "type": "boolean",
            "description": "Альбом добавлен целиком."
          },
          "mbid": {
            "type": "string",
            "format": "uuid",
            "description": "MBID release group."
          },
          "primary_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "status_counts": {
            "$ref": "#/components/schemas/StatusCounts"
          },
          "title": {
            "type": "string"
          },
          "track_count": {
            "type": "integer",
            "format": "int64",
            "description": "Все треки альбома (не только добавленные в библиотеку)."
          },
          "year": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          }
        }
      },
      "AlbumPage": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AlbumDto"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "AlbumResult": {
        "type": "object",
        "required": [
          "mbid",
          "title",
          "artist_mbid",
          "artist_name",
          "secondary_types",
          "cover_url",
          "score"
        ],
        "properties": {
          "artist_mbid": {
            "type": "string",
            "format": "uuid"
          },
          "artist_name": {
            "type": "string"
          },
          "cover_url": {
            "type": "string"
          },
          "library_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "mbid": {
            "type": "string",
            "format": "uuid"
          },
          "primary_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "score": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "secondary_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "title": {
            "type": "string"
          },
          "year": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          }
        }
      },
      "ArtistDetailDto": {
        "type": "object",
        "required": [
          "artist",
          "albums"
        ],
        "properties": {
          "albums": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AlbumDto"
            },
            "description": "Альбомы, в которых хоть что-то в библиотеке."
          },
          "artist": {
            "$ref": "#/components/schemas/ArtistDto"
          }
        }
      },
      "ArtistDto": {
        "type": "object",
        "required": [
          "id",
          "mbid",
          "name",
          "in_library",
          "album_count",
          "track_count"
        ],
        "properties": {
          "album_count": {
            "type": "integer",
            "format": "int64",
            "description": "Альбомы артиста, в которых хоть что-то в библиотеке."
          },
          "disambiguation": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "in_library": {
            "type": "boolean"
          },
          "mbid": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "track_count": {
            "type": "integer",
            "format": "int64",
            "description": "Треки артиста в библиотеке."
          }
        }
      },
      "ArtistPage": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ArtistDto"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
